# Copy to .env and choose a local practice password (at least 8 characters).
# Use letters/digits for this exercise to avoid Compose $ interpolation.
NEO4J_PASSWORD=change-this-lab-password
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_DATABASE=neo4j
# Django development server only; the app has no login/session functionality.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Generate locally: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Keep private. Without a value, review drafts expire on server restart.
DJANGO_SECRET_KEY=

# Local development: free local inference (hardware/electricity costs remain).
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT=240
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=700

# In the company: set LLM_PROVIDER=litellm and use approved internal settings.
# Base URL includes /v1 when your gateway uses that prefix; do not append /chat/completions.
# Use a user/application key from the administrator, not a gateway master key.
LITELLM_BASE_URL=
LITELLM_MODEL=
LITELLM_API_KEY=
LITELLM_TIMEOUT=120
LITELLM_MAX_TOKENS=700
# Structured document extraction needs more output tokens than a short answer.
LLM_EXTRACTION_MAX_TOKENS=3000
# Optional local Ollama extraction context; unrelated to the company LiteLLM model.
OLLAMA_EXTRACTION_NUM_CTX=32768
